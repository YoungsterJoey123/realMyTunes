<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="681.0" prefWidth="807.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.mrs.GUI.Controller.MyTunesViewController">
    <children>
        <TextField fx:id="txtSongSearch" layoutX="359.0" layoutY="44.0" promptText="Search for song" AnchorPane.leftAnchor="359.0" AnchorPane.topAnchor="44.0" />

        <!-- Songs -->
        <TableView fx:id="tblSong" layoutX="473.0" layoutY="85.0" prefHeight="499.0" prefWidth="319.0">
            <columns>
                <TableColumn fx:id="colTitle" prefWidth="126.66668701171875" text="Title" />
                <TableColumn fx:id="colArtist" prefWidth="101.33331298828125" text="Artist" />
                <TableColumn fx:id="colGenre" prefWidth="70.00006103515625" text="Genre" />
                <TableColumn fx:id="colTime" prefWidth="45.33343505859375" text="Time" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <Button fx:id="btnNewSong" layoutX="473.0" layoutY="593.0" mnemonicParsing="false" onAction="#handleCreateNewSong" text="New Song" />
        <Button fx:id="btnEdit" layoutX="555.0" layoutY="593.0" mnemonicParsing="false" onAction="#handleUpdateSong" text="Edit" />
        <Button fx:id="btnDelete" layoutX="605.0" layoutY="593.0" mnemonicParsing="false" onAction="#handleDeleteSong" text="Delete" />

        <!-- Song input fields -->
        <TextField fx:id="txtSongTitle" layoutX="473.0" layoutY="630.0" prefWidth="150.0" promptText="Title" />
        <TextField fx:id="txtSongArtist" layoutX="633.0" layoutY="630.0" prefWidth="150.0" promptText="Artist" />
        <TextField fx:id="txtSongGenre" layoutX="473.0" layoutY="660.0" prefWidth="150.0" promptText="Genre" />
        <TextField fx:id="txtSongTime" layoutX="633.0" layoutY="660.0" prefWidth="150.0" promptText="Time (seconds)" />

        <!-- Playlists -->
        <Text layoutX="18.0" layoutY="105.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Playlists" wrappingWidth="80.0" />
        <TableView fx:id="tblPlaylist" layoutX="16.0" layoutY="109.0" prefHeight="403.0" prefWidth="235.0">
            <columns>
                <TableColumn fx:id="colPlaylistName" prefWidth="75.0" text="Name" />
                <TableColumn fx:id="colPlaylistSongs" prefWidth="75.0" text="Songs" />
                <TableColumn fx:id="colPlaylistTime" prefWidth="75.0" text="Time" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <Button fx:id="btnNewPlaylist" layoutX="23.0" layoutY="523.0" mnemonicParsing="false" onAction="#handleNewPlaylist" text="New Playlist" />

        <!-- Songs on selected playlist -->
        <TableView fx:id="tblPlaylistSongs" layoutX="253.0" layoutY="164.0" prefHeight="200.0" prefWidth="200.0">
            <columns>
                <TableColumn fx:id="colPlaylistSongTitle" prefWidth="100.0" text="Title" />
                <TableColumn fx:id="colPlaylistSongArtist" prefWidth="100.0" text="Artist" />
            </columns>
        </TableView>
    </children>
</AnchorPane>